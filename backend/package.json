{
  "name": "opencrib-backend",
  "version": "1.0.0",
  "description": "OpenCrib backend API",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "migrate": "node scripts/migrate.js",
    "migrate:status": "node scripts/migrate.js --status",
    "test": "node scripts/migrate.js && node --test --test-concurrency=1 src/__tests__/*.test.js src/search/__tests__/*.test.js",
    "test:unit": "node --test src/__tests__/auth.middleware.test.js src/search/__tests__/*.test.js",
    "seed": "node scripts/seed.js",
    "unseed": "node scripts/seed.js --unseed"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1053.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.3.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.1.1",
    "pg": "^8.11.3",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "supertest": "^7.2.2"
  }
}
