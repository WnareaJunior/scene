# Supabase Session Pooler (port 5432, IPv4-compatible, recommended for serverless/Node.js)
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
# Generate each secret with: openssl rand -base64 64
JWT_ACCESS_SECRET=REPLACE_ME
JWT_REFRESH_SECRET=REPLACE_ME
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
PORT=3000
ALLOWED_ORIGINS=https://yourapp.example.com,https://www.yourapp.example.com
# Supabase Storage for avatar uploads
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=REPLACE_ME
SUPABASE_BUCKET=scene
