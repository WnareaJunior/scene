# ── Database ─────────────────────────────────────────────────────────────────
# Production: Supabase Session Pooler (port 5432, IPv4-compatible)
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
#
# Local dev: the shared Postgres on the devbox (password in the home-server
# repo's .secrets/data.env). Local Postgres has no TLS, hence DATABASE_SSL.
#DATABASE_URL=postgresql://dev:[password]@devbox:5433/scene
#DATABASE_SSL=disable

# Generate each secret with: openssl rand -base64 64
JWT_ACCESS_SECRET=REPLACE_ME
JWT_REFRESH_SECRET=REPLACE_ME
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
PORT=3000
ALLOWED_ORIGINS=https://yourapp.example.com,https://www.yourapp.example.com

# ── Image storage (src/storage.js) ───────────────────────────────────────────
# Production: Supabase Storage (STORAGE_DRIVER defaults to "supabase")
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=REPLACE_ME
SUPABASE_BUCKET=scene
#
# Local dev: MinIO on the devbox — same S3 API, no cloud account.
# Credentials live in the home-server repo's .secrets/devtools.env.
#STORAGE_DRIVER=s3
#S3_ENDPOINT=http://devbox:9000
#S3_BUCKET=scene
#S3_ACCESS_KEY=devbox
#S3_SECRET_KEY=REPLACE_ME
