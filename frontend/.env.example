# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real keys.

# Google Maps API key for iOS (restrict to the iOS bundle identifier in Google Cloud Console)
GOOGLE_MAPS_API_KEY_IOS=your_ios_google_maps_api_key_here

# Google Maps API key for Android (restrict to the Android package name + SHA-1 in Google Cloud Console)
GOOGLE_MAPS_API_KEY_ANDROID=your_android_google_maps_api_key_here
