# Copy to .env for local runs. In CI these come from GitHub Actions secrets.

# Pre-seeded test account (must exist on the target API, with a bio set).
E2E_EMAIL=scene.e2e@e2e.test
E2E_PASSWORD=<ask Wilson / see CI secrets>
E2E_USERNAME=scene_e2e

# Rate-limit bypass: must match the API deploy's E2E_RATE_LIMIT_BYPASS env var.
# Leave empty if the API has no bypass configured (tests may 429 in CI).
E2E_KEY=

# Where the static web build is served (Playwright starts this itself).
E2E_WEB_URL=http://localhost:4173
